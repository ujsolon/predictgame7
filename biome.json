{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**/*.{js,jsx,ts,tsx,css,scss}",
      "supabase/functions/**/*.ts",
      "supabase/scripts/**/*.ts",
      "tests/**/*.{js,jsx,ts,tsx}",
      "tailwind.config.js"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": {
        "noUndeclaredDependencies": "error"
      },
      "suspicious": {
        "noRedeclare": "error"
      },
      "style": {
        "noCommonJs": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "posthog-js": "AD-1 / NFR-V1: import analytics from @/lib/analytics, the only place the vendor SDK may be imported.",
              "@posthog/react": "AD-1 / NFR-V1: import analytics from @/lib/analytics, the only place the vendor SDK may be imported."
            },
            "patterns": [
              {
                "group": ["posthog-js/**", "@posthog/**"],
                "message": "AD-1 / NFR-V1: import analytics from @/lib/analytics, the only place the vendor SDK may be imported."
              }
            ]
          }
        }
      }
    }
  },
  "formatter": {
    "enabled": false
  },
  "css": {
    "parser": {
      "cssModules": false,
      "allowWrongLineComments": false,
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "src/lib/analytics/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tailwind.config.js"
      ],
      "linter": {
        "rules": {
          "style": {
            "noCommonJs": "off"
          }
        }
      }
    }
  ]
}